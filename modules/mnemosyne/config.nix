# Adapted from https://github.com/sioodmy/dotfiles/blob/1c692cbf6af349a568eb6ca2213eefbc42c43f39/modules/staypls/default.nix
{
  config,
  lib,
  ...
}: let
  inherit
    (lib)
    mkIf
    mkDefault
    mkMerge
    forEach
    ;
  mapList = lib.map;
  inherit
    (lib.strings)
    concatStringsSep
    normalizePath
    ;
  cfg = config.mnemosyne;
  persistPath = path: normalizePath "${cfg.persistDir}${path}";
  machineIdPath = persistPath "/etc/machine-id";
  mkMounts = dirs:
    dirs
    |> mapList (path: {
      "${path}" = {
        device = persistPath path;
        fsType = "none";
        options = cfg.mountOpts;
      };
    })
    |> mkMerge;

  # Compose a script to create the necessary directories in the persisted state
  # storage. `root` prefixes the mount root: in systemd-initrd the persist volume
  # is mounted under /sysroot, so the source dirs must be created there.
  mkSourcePaths = root: dirs: dirs |> (dirs: forEach dirs (path: "mkdir -p ${root}${persistPath path}")) |> concatStringsSep "\n";
in {
  # TODO: Add a check to ensure that `cfg.persistDir` is on a persisted volume
  config = mkIf cfg.enable {
    # Base directories always persisted; service modules contribute the rest.
    mnemosyne.dirs = [
      "/etc/nixos"
      "/etc/NetworkManager/system-connections"
      "/var/lib/bluetooth"
      "/var/lib/pipewire"
      "/etc/secrets"
    ];

    # SSH host keys are the only stateful part of /etc/ssh; everything else
    # (sshd_config, ssh_config, moduli) is generated by NixOS into /etc. Persist
    # only the keys by pointing sshd at the persist volume - bind-mounting the
    # whole /etc/ssh would shadow the generated sshd_config with an (initially
    # empty) dir, so sshd dies with "/etc/ssh/sshd_config: No such file".
    # sshd-keygen mkdir -p's the parent and skips regeneration if the key exists,
    # so hosts already storing keys here keep them.
    services.openssh.hostKeys = mkIf config.services.openssh.enable [
      {
        path = "${cfg.persistDir}/etc/ssh/ssh_host_ed25519_key";
        type = "ed25519";
      }
      {
        bits = 4096;
        path = "${cfg.persistDir}/etc/ssh/ssh_host_rsa_key";
        type = "rsa";
      }
    ];

    # Persist bind-mounts must exist before stage-2, which needs systemd in the
    # initrd (the make-source-of-persistent-dirs unit below runs there).
    boot.initrd.systemd.enable = mkDefault true;
    fileSystems = mkMounts cfg.dirs;
    # Ensure that the necessary paths exist in the persisted state storage before
    # the stage-2 bind mounts (and before switch-root). systemd-initrd mounts
    # neededForBoot filesystems under /sysroot, so:
    #   - order with RequiresMountsFor on the /sysroot-prefixed path: systemd
    #     resolves the real mount unit (e.g. sysroot-nix-persist.mount) by path,
    #     avoiding the fragile hand-computed unit name that never matched; and
    #   - mkdir into /sysroot<persistDir>, the actual mounted volume, not the
    #     ephemeral initrd ramfs.
    # before=initrd-fs.target (not sysroot.mount): the persist submount is itself
    # ordered after sysroot.mount, so ordering before it would deadlock.
    boot.initrd.systemd.services.make-source-of-persistent-dirs = {
      wantedBy = ["initrd-fs.target"];
      before = ["initrd-fs.target"];
      unitConfig = {
        DefaultDependencies = false;
        RequiresMountsFor = "/sysroot${cfg.persistDir}";
      };
      serviceConfig.Type = "oneshot";
      script = ''
        ${mkSourcePaths "/sysroot" cfg.dirs}

        mkdir -p /sysroot${cfg.persistDir}/etc /sysroot/etc
        if [ ! -s /sysroot${machineIdPath} ]; then
          uuid="$(cat /proc/sys/kernel/random/uuid)"
          printf '%s\n' "''${uuid//-/}" > /sysroot${machineIdPath}
          chmod 0444 /sysroot${machineIdPath}
        fi
        cp /sysroot${machineIdPath} /sysroot/etc/machine-id
      '';
    };

    # Preserve the current identity before the next boot starts from tmpfs.
    system.activationScripts.mnemosyne-machine-id = ''
      mkdir -p ${cfg.persistDir}/etc
      if [ ! -s ${machineIdPath} ] && [ -s /etc/machine-id ]; then
        cp /etc/machine-id ${machineIdPath}
        chmod 0444 ${machineIdPath}
      fi
    '';
  };
}
