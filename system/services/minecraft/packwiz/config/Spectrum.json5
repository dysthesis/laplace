{
	// Recipe and unlock popups stay visible for this duration in milliseconds.
	"ToastTimeMilliseconds": 7500,
	"DimensionReverbDecayTime": 8.0,
	"DimensionReverbDensity": 0.5,
	"WindSim": true,
	"ReducedParticles": false,
	// Lower intervals make wind simulation smoother but increase computation.
	"WindSimInterval": 3,
	// Extra darkness blocks night vision and makes travel harder.
	"ExtraDarkDimension": false,
	// Pastel Network items produce particles.
	"PastelNetworkParticles": true,
	// A change of 1 has a large effect on dimension brightness.
	"DimensionBrightnessMod": 1.0,
	// List mod IDs with integration pack conflicts to skip those packs.
	"IntegrationPacksToSkipLoading": [],
	// Tooltips include details such as whether Sculk Shriekers can summon the Warden.
	"AddItemTooltips": true,
	// Use simpler transfer models for better visibility.
	"MinimalNodes": false,
	// True lets the bedrock anvil exceed vanilla enchantment limits, including those on enchanted books.
	"BedrockAnvilCanExceedMaxVanillaEnchantmentLevel": false,
	// Endermen spawn with treasure at separate rates in the End and other dimensions.
	// Treasure blocks are not necessary for progression.
	"EndermanHoldingEnderTreasureChance": 0.10000000149011612,
	"EndermanHoldingEnderTreasureInEndChance": 0.007499999832361937,
	// Shooting stars require sufficient player progression in these worlds.
	"ShootingStarWorlds": [
		"minecraft:overworld",
		"starry_skies:overworld",
		"paradise_lost:paradise_lost"
	],
	// Lightning can produce Storm Stones in these worlds.
	"StormStonesWorlds": [
		"minecraft:overworld",
		"starry_skies:overworld",
		"paradise_lost:paradise_lost"
	],
	"StormStonesChance": 0.4000000059604645,
	// Use a biome tag for Quitoxic reed spawns rather than hot, wet, non-ocean biomes.
	"QuitoxicSpawnTag": false,
	// Check for shooting stars every 100 ticks between time 13000 and 22000.
	// The default chance of 0.75% gives about one star per night for each eligible player.
	"ShootingStarChance": 0.007499999832361937,
	// Set the Pigment Pedestal time in ticks for Crafting Table recipes without upgrades.
	// Use 0 or less to disable these recipes.
	"VanillaRecipeCraftingTimeTicks": 40,
	// Set the fraction of random ticks that spread decay.
	// High rates can remove the feedback that players need for progression.
	// A value of 1.0 uses every random tick. A value of 0.5 uses every second random tick.
	// Do not use 0.0. It prevents progression.
	"FadingDecayTickRate": 1.0,
	"FailingDecayTickRate": 1.0,
	"RuinDecayTickRate": 1.0,
	"ForfeitureDecayTickRate": 1.0,
	// Bottles can collect decay when these options are true.
	"CanBottleUpFading": true,
	"CanBottleUpFailing": true,
	"CanBottleUpRuin": true,
	"CanBottleUpForfeiture": true,
	// These options let decay replace block entities.
	"FadingCanDestroyBlockEntities": false,
	"FailingCanDestroyBlockEntities": false,
	"RuinCanDestroyBlockEntities": false,
	"ForfeitureCanDestroyBlockEntities": true,
	"LogPlacingOfDecay": true,
	// Use 0.0 to mute Spectrum crafting blocks.
	"BlockSoundVolume": 0.5,
	// An empty name scrambles enchantment names until the player unlocks them.
	"NameForUnrevealedEnchantments": "",
	// Resonance and Voiding cannot be disabled.
	// Other enchantment switches disable registration and Enchantment Upgrade Recipes, but leave other recipes active.
	"FoundryEnchantmentEnabled": true,
	"ExuberanceEnchantmentEnabled": true,
	"InventoryInsertionEnchantmentEnabled": true,
	"PestControlEnchantmentEnabled": true,
	"TreasureHunterEnchantmentEnabled": true,
	"DisarmingEnchantmentEnabled": true,
	"FirstStrikeEnchantmentEnabled": true,
	"ImprovedCriticalEnchantmentEnabled": true,
	"InertiaEnchantmentEnabled": true,
	"CloversFavorEnchantmentEnabled": true,
	"SniperEnchantmentEnabled": true,
	"TightGripEnchantmentEnabled": true,
	"SteadfastEnchantmentEnabled": true,
	"IndestructibleEnchantmentEnabled": true,
	"BigCatchEnchantmentEnabled": true,
	"SerendipityReelEnchantmentEnabled": true,
	"RazingEnchantmentEnabled": true,
	"InexorableEnchantmentEnabled": true,
	"TreasureHunterMaxLevel": 3,
	"DisarmingMaxLevel": 2,
	"FirstStrikeMaxLevel": 2,
	"ImprovedCriticalMaxLevel": 2,
	"InertiaMaxLevel": 3,
	"CloversFavorMaxLevel": 3,
	"TightGripMaxLevel": 2,
	"BigCatchMaxLevel": 3,
	"SerendipityReelMaxLevel": 2,
	// Exuberance increases XP from mob kills. Five levels at 25% per level give 2.25 times the normal XP.
	"ExuberanceMaxLevel": 5,
	"ExuberanceBonusExperiencePercentPerLevel": 0.25,
	// Vanilla critical hits add 50% damage. Improved Critical adds another 50% per level by default.
	"ImprovedCriticalExtraDamageMultiplierPerLevel": 0.5,
	"FirstStrikeDamagePerLevel": 2.0,
	// Set the chance per enchantment level that Disarming removes a mob's armour or held items.
	"DisarmingChancePerLevelMobs": 0.009999999776482582,
	// Values above 0 let Disarming remove player equipment. Keep this chance much lower than the mob chance.
	"DisarmingChancePerLevelPlayers": 0.0010000000474974513,
	"TightGripAttackSpeedBonusPercentPerLevel": 0.0625,
	// Set the night vision duration in seconds per glow ink sac with a glow vision helmet.
	"GlowVisionGogglesDuration": 240,
	// The requires_omni_accelerator_pvp_enabled item tag controls Omni Accelerator actions that drain player XP or change equipment.
	"OmniAcceleratorPvP": false,
	"GemstoneArmorHelmetProtection": 3,
	"GemstoneArmorChestplateProtection": 7,
	"GemstoneArmorLeggingsProtection": 5,
	"GemstoneArmorBootsProtection": 3,
	"GemstoneArmorToughness": 0.0,
	"GemstoneArmorKnockbackResistance": 0.0,
	"GemstoneArmorWeaknessAmplifier": 1,
	"GemstoneArmorSlownessAmplifier": 1,
	"GemstoneArmorAbsorptionAmplifier": 0,
	"GemstoneArmorResistanceAmplifier": 0,
	"GemstoneArmorRegenerationAmplifier": 0,
	"GemstoneArmorSpeedAmplifier": 1,
	"BedrockArmorHelmetProtection": 5,
	"BedrockArmorLeggingsProtection": 9,
	"BedrockArmorChestplateProtection": 13,
	"BedrockArmorBootsProtection": 5,
	"BedrockArmorToughness": 3.0,
	"BedrockArmorKnockbackResistance": 0.30000001192092896,
	"MaxLevelForEffectsInLesserPotionPendant": 3,
	"MaxLevelForEffectsInGreaterPotionPendant": 1,
	// True stops Decay in claims and can prevent player progression.
	// Tell players that Decay does not work in their claims.
	"DecayIsStoppedByClaimMods": false,
	// True shows the Roughly Enough Items screen for locked recipes. False hides recipes until the player unlocks them.
	"REIListsRecipesAsNotUnlocked": true,
	// Azure Dike Charges appear above the food bar by default.
	// Change these offsets only to avoid other GUI overlays.
	"AzureDikeHudOffsetX": 0,
	"AzureDikeHudOffsetY": 0,
	"AzureDikeHudOffsetYWithArmor": -10,
	"AzureDikeHudOffsetYForEachRowOfExtraHearts": -10
}