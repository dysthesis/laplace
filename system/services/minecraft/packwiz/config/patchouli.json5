{
	// Show all entries in all books. Config Flag: advancements_disabled
	"disableAdvancementLocking": false,
	// Unlock these book IDs, such as "botania:lexicon". Config Flags: advancements_disabled_<bookid>
	"noAdvancementBooks": [],
	// Books can use this flag for tests. Config Flag: testing_mode
	"testingMode": false,
	// Replace the inventory recipe book with this book ID.
	"inventoryButtonBook": "",
	"useShiftForQuickLookup": false,
	// OVERFLOW extends past the page. TRUNCATE cuts excess text. RESIZE fits all text.
	// Reconnect to apply changes.
	"textOverflowMode": "RESIZE",
	// Hold the quick lookup key for this many ticks to open the book.
	"quickLookupTime": 10
}