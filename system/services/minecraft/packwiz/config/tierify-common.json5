{
  // Add modifiers to items in loot containers, such as mineshaft chests.
  "lootContainerModifier": true,
  // Add modifiers to entity equipment.
  "entityItemModifier": true,
  "craftingModifier": true,
  "merchantModifier": true,
  // Reduce the largest weights by this factor.
  "reforgeModifier": 0.9,
  // Adjust the largest weights by this factor per smithing level.
  "levelzReforgeModifier": 0.01,
  // Adjust the largest weights by this factor per luck point.
  "luckReforgeModifier": 0.02,
  // Tier 1 materials permit these qualities. Limestone is the default material.
  // Use the tiered:reforge_tier_1 item tag to change the material.
  "tier_1_qualities": [
    "Common",
    "Uncommon",
    "Rare"
  ],
  // Tier 2 materials permit these qualities. Pyrite is the default material.
  // Use the tiered:reforge_tier_2 item tag to change the material.
  "tier_2_qualities": [
    "Uncommon",
    "Rare",
    "Epic",
    "Legendary"
  ],
  // Tier 3 materials permit these qualities. Galena is the default material.
  // Use the tiered:reforge_tier_3 item tag to change the material.
  "tier_3_qualities": [
    "Rare",
    "Epic",
    "Legendary",
    "Mythic"
  ]
}