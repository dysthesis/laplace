{
	// Villagers use Numismatic currency for trades.
	"enableVillagerTrading": true,
	// Add Numismatic currency to chest loot.
	"generateCurrencyInChests": true,
	// Reconnect to apply changes to the purse notification position.
	"moneyMessageLocation": "ACTIONBAR",
	"purseOffsets": {
		"survivalX": 0,
		"survivalY": 0,
		"creativeX": 0,
		"creativeY": 0,
		"merchantX": 0,
		"merchantY": 0
	},
	"lootOptions": {
		// Set money limits for Desert Temple chests.
		"desertMinLoot": 300,
		"desertMaxLoot": 1200,
		// Set money limits for Dungeon and Mineshaft chests.
		"dungeonMinLoot": 500,
		"dungeonMaxLoot": 2000,
		// Set money limits for Bastion, Stronghold, Outpost and Buried Treasure chests.
		"structureMinLoot": 1500,
		"structureMaxLoot": 4000,
		"strongholdLibraryMinLoot": 2000,
		"strongholdLibraryMaxLoot": 6000
	},
	// The moneyMobDropVariancePercentage game rule scales each entity's base drop.
	// For about 80 Bronze Coins per pillager, use "minecraft:pillager": 80.
	// Restart to apply changes.
	"mobsToBaseValues": { },
	// Multiply drops by '(mob max health) / (20 * healthScaleReduction)'.
	"scaleOnHealth": false,
	// Reduce the effect of mob health on money drops. Restart to apply changes.
	"healthScaleReduction": 1.0
}