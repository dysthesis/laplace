{
  // Limit new villager trades per level. (Default: 2)
  "trade_offers_per_level": 2,
  // Limit wandering trader trades. (Default: 5)
  "trade_offers_wandering_trader": 5,
  // Limit experience in the enchanted basin. (Default: 500)
  "max_exp_amount": 500,
  // Transfer this much experience per basin interaction. (Default: 50)
  "exp_amount": 50,
  // Let the alchemist workstation explode. (Default: true)
  "can_explode": true,
  // Set the one-in-N chance of no explosion. N must exceed 0. (Default: 3)
  "explosion_chance": 3,
  // Higher house weights increase the chance of generation.
  "plains_alchemist_weight": 10,
  "plains_occultist_weight": 10,
  "plains_horticulturist_weight": 7,
  "plains_oceanographer_weight": 15,
  "taiga_alchemist_weight": 10,
  "taiga_occultist_weight": 10,
  "taiga_horticulturist_weight": 7,
  "taiga_oceanographer_weight": 15,
  "savanna_alchemist_weight": 10,
  "savanna_occultist_weight": 10,
  "savanna_horticulturist_weight": 7,
  "savanna_oceanographer_weight": 15,
  "snowy_alchemist_weight": 10,
  "snowy_occultist_weight": 10,
  "snowy_horticulturist_weight": 7,
  "snowy_oceanographer_weight": 15,
  "desert_alchemist_weight": 10,
  "desert_occultist_weight": 10,
  "desert_horticulturist_weight": 7,
  "desert_oceanographer_weight": 15,
  // For two small flowers, add each offset to the offsets that follow.
  "first_flower_in_two_X_offset": 0.15,
  "first_flower_in_two_Z_offset": 0.15,
  "second_flower_in_two_X_offset": -0.3,
  "second_flower_in_two_Z_offset": -0.35,
  // For three small flowers, add each offset to the offsets that follow.
  "first_flower_in_three_X_offset": 0.15,
  "first_flower_in_three_Z_offset": 0.0,
  "second_flower_in_three_X_offset": -0.3,
  "second_flower_in_three_Z_offset": -0.15,
  "third_flower_in_three_X_offset": -0.05,
  "third_flower_in_three_Z_offset": 0.3,
  // For four small flowers, add each offset to the offsets that follow.
  "first_flower_in_four_X_offset": 0.15,
  "first_flower_in_four_Z_offset": 0.15,
  "second_flower_in_four_X_offset": 0.0,
  "second_flower_in_four_Z_offset": -0.35,
  "third_flower_in_four_X_offset": -0.3,
  "third_flower_in_four_Z_offset": 0.0,
  "forth_flower_in_four_X_offset": -0.05,
  "forth_flower_in_four_Z_offset": 0.37
}
