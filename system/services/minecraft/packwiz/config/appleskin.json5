{
	// Show food hunger and saturation values in tooltips with SHIFT.
	"showFoodValuesInTooltip": true,
	// Show food values without SHIFT.
	"showFoodValuesInTooltipAlways": true,
	// Show saturation above the hunger bar.
	"showSaturationHudOverlay": true,
	// Show hunger that held food can restore. Saturation requires showSaturationHudOverlay.
	"showFoodValuesHudOverlay": true,
	// Include off-hand food in the hunger, saturation and health overlays.
	"showFoodValuesHudOverlayWhenOffhand": true,
	// Show exhaustion behind the hunger bar.
	"showFoodExhaustionHudUnderlay": true,
	"showFoodHealthHudOverlay": true,
	// Show hunger, saturation and exhaustion in the Debug Screen.
	"showFoodDebugInfo": true,
	// Match overlay movement to Minecraft health and hunger icons.
	"showVanillaAnimationsOverlay": true,
	// Set peak icon opacity. Use 1.0 for fully opaque or 0.0 for fully transparent.
	"maxHudOverlayFlashAlpha": 0.6499999761581421
}