{
	"backpackSettings": {
		"leather": {
			"inventorySlotCount": 27,
			"upgradeSlotCount": 2,
			"toolSlotCount": 2,
			// Set tank capacity per row. 81000 equals one bucket.
			"tankCapacityPerRow": 81000
		},
		"iron": {
			"inventorySlotCount": 45,
			"upgradeSlotCount": 3,
			"toolSlotCount": 3,
			// Set tank capacity per row. 81000 equals one bucket.
			"tankCapacityPerRow": 81000
		},
		"gold": {
			"inventorySlotCount": 63,
			"upgradeSlotCount": 4,
			"toolSlotCount": 4,
			// Set tank capacity per row. 81000 equals one bucket.
			"tankCapacityPerRow": 81000
		},
		"diamond": {
			"inventorySlotCount": 81,
			"upgradeSlotCount": 5,
			"toolSlotCount": 5,
			// Set tank capacity per row. 81000 equals one bucket.
			"tankCapacityPerRow": 81000
		},
		"netherite": {
			"inventorySlotCount": 99,
			"upgradeSlotCount": 6,
			"toolSlotCount": 6,
			// Set tank capacity per row. 81000 equals one bucket.
			"tankCapacityPerRow": 81000
		},
		// Right-click a backpack on the ground to equip it. Trinkets/Accessories Integration disables this action.
		"rightClickEquip": true,
		// Right-click the ground with an empty hand to remove the backpack. Trinkets/Accessories Integration disables this action.
		"rightClickUnequip": false,
		"allowOnlyEquippedBackpack": false,
		// Use the keybind over a backpack inventory slot to open it.
		"allowOpeningFromSlot": false,
		// Permit only one player at a time to access a backpack on the ground.
		"preventMultiplePlayersAccess": false,
		// Protect backpacks from all damage and prevent floating items from disappearing.
		"invulnerableBackpack": true,
		// Exchange tools with the player inventory through the quick-swap menu.
		"allowToolSwapping": true,
		// Use registry names for accepted tool slot items, such as minecraft:apple or minecraft:flint.
		"toolSlotsAcceptableItems": [],
		// Use registry names for blocked backpack items, such as minecraft:apple or minecraft:flint.
		"blacklistedItems": [],
		"toolSlotsAcceptEverything": false,
		// Permit shulker boxes and other inventory items inside backpacks.
		"allowShulkerBoxes": false,
		// Place a floating backpack above minimum Y after a void death.
		"voidProtection": true,
		"backpackDeathPlace": true,
		// At the death location, replace breakable blocks without inventories. This requires backpackDeathPlace.
		"backpackForceDeathPlace": false,
		// Use the sleeping bag while the backpack remains equipped.
		"quickSleepingBag": true,
		"enableSleepingBagSpawnPoint": false,
		// True requires the Trinkets/Accessories 'Back' slot if either mod is installed. False uses the Backpack GUI button.
		// Changes preserve equipped backpacks. Retrieve them through the player inventory.
		"trinketsIntegration": true
	},
	"backpackUpgrades": {
		"enableSleepingBag": true,
		"enableTanksUpgrade": true,
		"enableCraftingUpgrade": true,
		"enableFurnaceUpgrade": true,
		"enableSmokerUpgrade": true,
		"enableBlastFurnaceUpgrade": true,
		"enableJukeboxUpgrade": true,
		"pickupUpgradeSettings": {
			"enableUpgrade": true,
			"filterSlotCount": 9,
			"slotsInRow": 3
		},
		"magnetUpgradeSettings": {
			"enableUpgrade": true,
			"filterSlotCount": 9,
			"slotsInRow": 3,
			"pullRange": 5,
			"tickRate": 10
		},
		"feedingUpgradeSettings": {
			"enableUpgrade": true,
			"filterSlotCount": 9,
			"slotsInRow": 3,
			"tickRate": 100
		},
		"refillUpgradeSettings": {
			"enableUpgrade": true,
			"filterSlotCount": 9,
			"slotsInRow": 3,
			"tickRate": 5
		},
		"voidUpgradeSettings": {
			"enableUpgrade": true,
			"filterSlotCount": 9,
			"slotsInRow": 3
		},
		"enableLanternUpgrade": true
	},
	"world": {
		"enableLoot": true,
		// Let Zombies, Skeletons, Wither Skeletons, Piglins and Endermen spawn with random backpacks.
		"spawnEntitiesWithBackpack": true,
		// Do not add entity types. Added types crash the game. Remove entries to block backpack spawns.
		"possibleOverworldEntityTypes": [
			"minecraft:zombie",
			"minecraft:skeleton",
			"minecraft:enderman"
		],
		// Do not add entity types. Added types crash the game. Remove entries to block backpack spawns.
		"possibleNetherEntityTypes": [
			"minecraft:wither_skeleton",
			"minecraft:piglin"
		],
		// Set the entity spawn chance with a backpack.
		"chance": 0.004999999888241291,
		"overworldBackpacks": [
			"travelersbackpack:standard",
			"travelersbackpack:diamond",
			"travelersbackpack:gold",
			"travelersbackpack:emerald",
			"travelersbackpack:iron",
			"travelersbackpack:lapis",
			"travelersbackpack:redstone",
			"travelersbackpack:coal",
			"travelersbackpack:bookshelf",
			"travelersbackpack:sandstone",
			"travelersbackpack:snow",
			"travelersbackpack:sponge",
			"travelersbackpack:cake",
			"travelersbackpack:cactus",
			"travelersbackpack:hay",
			"travelersbackpack:melon",
			"travelersbackpack:pumpkin",
			"travelersbackpack:creeper",
			"travelersbackpack:enderman",
			"travelersbackpack:skeleton",
			"travelersbackpack:spider",
			"travelersbackpack:bee",
			"travelersbackpack:wolf",
			"travelersbackpack:fox",
			"travelersbackpack:ocelot",
			"travelersbackpack:horse",
			"travelersbackpack:cow",
			"travelersbackpack:pig",
			"travelersbackpack:sheep",
			"travelersbackpack:chicken",
			"travelersbackpack:squid"
		],
		"netherBackpacks": [
			"travelersbackpack:quartz",
			"travelersbackpack:nether",
			"travelersbackpack:blaze",
			"travelersbackpack:ghast",
			"travelersbackpack:magma_cube",
			"travelersbackpack:wither"
		],
		// Let Librarians sell Villager Backpacks.
		"enableVillagerTrade": true
	},
	"backpackAbilities": {
		"enableBackpackAbilities": true,
		// Enable abilities on new backpacks by default.
		"forceAbilityEnabled": true,
		// Do not add backpack types. Added types crash the game. Remove entries to disable abilities.
		"allowedAbilities": [
			"travelersbackpack:netherite",
			"travelersbackpack:diamond",
			"travelersbackpack:gold",
			"travelersbackpack:emerald",
			"travelersbackpack:iron",
			"travelersbackpack:lapis",
			"travelersbackpack:redstone",
			"travelersbackpack:bookshelf",
			"travelersbackpack:sponge",
			"travelersbackpack:cake",
			"travelersbackpack:cactus",
			"travelersbackpack:melon",
			"travelersbackpack:pumpkin",
			"travelersbackpack:creeper",
			"travelersbackpack:dragon",
			"travelersbackpack:enderman",
			"travelersbackpack:blaze",
			"travelersbackpack:ghast",
			"travelersbackpack:magma_cube",
			"travelersbackpack:spider",
			"travelersbackpack:wither",
			"travelersbackpack:warden",
			"travelersbackpack:bat",
			"travelersbackpack:bee",
			"travelersbackpack:ocelot",
			"travelersbackpack:cow",
			"travelersbackpack:chicken",
			"travelersbackpack:squid",
			"travelersbackpack:hay",
			"travelersbackpack:fox"
		],
		// Assign effects to backpacks with this format:
		// "<backpack_registry_name>; <status_effect_registry_name>; <min_duration_ticks>; <max_duration_ticks>; <amplifier>"
		"backpackEffects": [
			"travelersbackpack:bat; minecraft:night_vision; 260; 300; 0",
			"travelersbackpack:magma_cube; minecraft:fire_resistance; 260; 300; 0",
			"travelersbackpack:squid; minecraft:water_breathing; 260; 300; 0",
			"travelersbackpack:squid; minecraft:night_vision; 260; 300; 0",
			"travelersbackpack:dragon; minecraft:regeneration; 260; 300; 0",
			"travelersbackpack:dragon; minecraft:strength; 250; 290; 0",
			"travelersbackpack:quartz; minecraft:haste; 260; 300; 0",
			"travelersbackpack:fox; minecraft:jump_boost; 260; 300; 0"
		],
		// Only the listed backpacks support cooldowns. Added backpacks do not gain cooldowns.
		// Format: "<backpack_registry_name>; <min_possible_cooldown_seconds>; <max_possible_cooldown_seconds>"
		"cooldowns": [
			"travelersbackpack:creeper; 1200; 1800",
			"travelersbackpack:cow; 480; 540",
			"travelersbackpack:chicken; 360; 600",
			"travelersbackpack:cake; 360; 480",
			"travelersbackpack:melon; 120; 480"
		]
	},
	"slownessDebuff": {
		"tooManyBackpacksSlowness": false,
		// Carry up to this many backpacks without slowness.
		"maxNumberOfBackpacks": 3,
		"slownessPerExcessedBackpack": 1
	},
	"client": {
		"toolsOverlay": {
			// Exchange the held item with the selected tool belt slot when the GUI closes.
			"swapOnClose": true,
			// False shows only the item name, not the full tooltip.
			"showTooltip": false,
			"renderBackpackIconInCenter": true,
			"opacity": 0.75,
			"offsetX": 0,
			"offsetY": 0
		},
		"overlay": {
			// Show tanks and tool slots while the backpack is equipped.
			"enableOverlay": true,
			// Positive values move the overlay left.
			"offsetX": 20,
			// Positive values move the overlay up.
			"offsetY": 30
		},
		"showBackpackIconInInventory": true,
		// Send backpack coordinates to the player after death.
		"sendBackpackCoordinatesMessage": true,
		// Use allowToolSwapping for tool exchange.
		"enableToolCycling": true,
		"disableScrollWheel": false,
		// Show how to obtain backpacks without crafting recipes.
		"obtainTips": true,
		// Show tool slot items on equipped backpacks.
		"renderTools": true,
		// Only supporters can show this badge: https://ko-fi.com/tiviacz1337
		"showSupporterBadge": true
	}
}