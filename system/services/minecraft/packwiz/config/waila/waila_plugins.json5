    // This requires WTHIT on the server. Otherwise, it remains false.
    // Default value: [true]
    "item.enabled_entity": true,
    // This requires WTHIT on the server. Otherwise, it remains false.
    // Default value: [true]
    "item.nbt": true,
    // GRID shows inventory-style slots. LIST shows a vertical list with names.
    // DYNAMIC changes from list to grid above the maximum height.
    // Default value: [DYNAMIC]
    // Available values: [GRID, LIST, DYNAMIC]
    "item.display_mode": "DYNAMIC",
    // Default value: [3]
    "item.max_height": 3,
    // Default value: [true]
    "item.sort_by_count": true,
    // Default value: [1.0]
    "item.grid_mode_scale": 1.0,
    // Change exclusions in extra/item_blacklist.json5.
    "item.blacklist": null,
    // This requires WTHIT on the server. Otherwise, it remains false.
    // Default value: [true]
    "progress.enabled_block": true,
    // This requires WTHIT on the server. Otherwise, it remains false.
    // Default value: [true]
    "progress.enabled_entity": true,
    // This requires WTHIT on the server. Otherwise, it remains false.
    // Default value: [true]
    "progress.time": true,
    // Replace item tooltips for recipes with item inputs or outputs. Otherwise, show only a progress bar.
    // Default value: [false]
    "progress.replace_items": false,
    // Set the progress bar height. This does not affect arrows.
    // Default value: [1]
    "progress.height": 1,
    // Change exclusions in extra/progress_blacklist.json5.
    "progress.blacklist": null
  }
