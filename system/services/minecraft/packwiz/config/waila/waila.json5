{
  general: {
    // Add the WTHIT configuration button to vanilla options.
    // Default value: [false]
    vanillaOptions: false,
    // Default value: [true]
    displayTooltip: true,
    // Show body text only during sneak mode.
    // Default value: [false]
    shiftForDetails: false,
    // Hide "Sneak for details" when shiftForDetails is enabled.
    // Default value: [false]
    hideShiftText: false,
    // TOGGLE switches the tooltip on or off. HOLD_KEY requires continuous key pressure.
    // Default value: [TOGGLE]
    // Available values: [HOLD_KEY, TOGGLE]
    displayMode: "TOGGLE",
    // Default value: [true]
    hideFromPlayerList: true,
    // Default value: [true]
    hideFromDebug: true,
    // Read block and entity names with system text-to-speech.
    // Default value: [false]
    enableTextToSpeech: false,
    // Set the server request interval in milliseconds. Use at least 250 ms.
    // Default value: [250]
    rateLimit: 250
  },
  overlay: {
    position: {
      align: {
        // Default value: [CENTER]
        // Available values: [LEFT, CENTER, RIGHT]
        x: "CENTER",
        // Default value: [TOP]
        // Available values: [TOP, MIDDLE, BOTTOM]
        y: "TOP"
      },
      anchor: {
        // Default value: [CENTER]
        // Available values: [LEFT, CENTER, RIGHT]
        x: "CENTER",
        // Default value: [TOP]
        // Available values: [TOP, MIDDLE, BOTTOM]
        y: "TOP"
      },
      // Default value: [0]
      x: 0,
      // Default value: [0]
      y: 0,
      // False moves the tooltip below boss bars only at the top-centre alignment.
      // Default value: [false]
      bossBarsOverlap: false
    },
    color: {
      // Default value: [204]
      backgroundAlpha: 204,
      themes: [],
      // Default value: [waila:vanilla]
      activeTheme: "waila:vanilla"
    },
    // Default value: [1.0]
    scale: 1.0,
    // Lower overlay FPS can improve game FPS. Use 0 for no limit.
    // Default value: [30]
    fps: 30
  },
  formatter: {
    // Default value: [§9§o%s]
    modName: "§9§o%s",
    // Default value: [§f%s]
    blockName: "§f%s",
    // Default value: [§f%s]
    fluidName: "§f%s",
    // Default value: [§f%s]
    entityName: "§f%s",
    // Default value: [§8%s]
    registryName: "§8%s",
    styles: {
      "§f%s": {
        field_11855: {
          field_24364: 16777215,
          field_24365: "white"
        },
        field_11856: false,
        field_11852: false,
        field_11851: false,
        field_11857: false,
        field_11861: false,
        field_11853: null,
        field_11858: null,
        field_11859: null,
        field_24361: null
      }
    }
  },
  keyBinds: {
    // Default value: [key.keyboard.unknown]
    openConfig: "key.keyboard.unknown",
    // Default value: [key.keyboard.unknown]
    showOverlay: "key.keyboard.unknown",
    // Default value: [key.keyboard.unknown]
    toggleLiquid: "key.keyboard.unknown",
    // Default value: [key.keyboard.unknown]
    showRecipeInput: "key.keyboard.unknown",
    // Default value: [key.keyboard.unknown]
    showRecipeOutput: "key.keyboard.unknown"
  },
  // Do not change this internal value.
  // Default value: [0]
  configVersion: 1
}