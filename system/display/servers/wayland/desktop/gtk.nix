palette: ''
  /* GTK 3 / Graphite and GTK 4 / libadwaita semantic colours. */
  @define-color theme_bg_color ${palette.background};
  @define-color theme_fg_color ${palette.foreground};
  @define-color theme_base_color ${palette.inset};
  @define-color theme_text_color ${palette.foreground};
  @define-color theme_selected_bg_color ${palette.border};
  @define-color theme_selected_fg_color ${palette.foreground};
  @define-color insensitive_fg_color ${palette.dim};
  @define-color borders ${palette.border};

  @define-color window_bg_color ${palette.background};
  @define-color window_fg_color ${palette.foreground};
  @define-color view_bg_color ${palette.inset};
  @define-color view_fg_color ${palette.foreground};
  @define-color headerbar_bg_color ${palette.surface};
  @define-color headerbar_fg_color ${palette.foreground};
  @define-color popover_bg_color ${palette.popup};
  @define-color popover_fg_color ${palette.foreground};
  @define-color dialog_bg_color ${palette.popup};
  @define-color dialog_fg_color ${palette.foreground};
  @define-color card_bg_color ${palette.surface};
  @define-color card_fg_color ${palette.foreground};
  @define-color sidebar_bg_color ${palette.surface};
  @define-color sidebar_fg_color ${palette.foreground};
  @define-color accent_color ${palette.focus};
  @define-color accent_bg_color ${palette.focus};
  @define-color accent_fg_color ${palette.background};
  @define-color success_color ${palette.success};
  @define-color warning_color ${palette.warning};
  @define-color error_color ${palette.urgent};
''
