# Repacks a raw disk image into a Proxmox VMA backup archive (vzdump-*.vma.zst),
# restorable with `qmrestore`.
#
# nixpkgs' `proxmox-image.nix` would normally produce the VMA, but its image
# builder (`nixos/lib/make-disk-image.nix`) asserts `partitionTableType != "none"
# -> fsType == "ext4"` and copies the system into a single root partition via
# `cptofs`. That cannot express our tmpfs-root + btrfs (`/nix`, `/nix/persist`)
# layout for impermanence. So disko builds the raw image and we reuse only
# the final VMA packaging step here.
#
# The `vma` tool is published solely as a patch atop upstream QEMU; the
# derivation below is lifted verbatim from nixpkgs' proxmox-image.nix and pinned.
# If the PVE patch/QEMU pin drifts upstream, refresh it from
# nixos/modules/virtualisation/proxmox-image.nix.
{
  lib,
  runCommand,
  writeTextDir,
  qemu_kvm,
  fetchurl,
  fetchFromGitHub,
  libuuid,
  perl,
  zstd,
}: let
  vma =
    (qemu_kvm.override {
      alsaSupport = false;
      pulseSupport = false;
      sdlSupport = false;
      jackSupport = false;
      gtkSupport = false;
      vncSupport = false;
      smartcardSupport = false;
      spiceSupport = false;
      ncursesSupport = false;
      libiscsiSupport = false;
      tpmSupport = false;
      numaSupport = false;
      seccompSupport = false;
      guestAgentSupport = false;
    })
    .overrideAttrs (super: {
      version = "9.0.0";
      src = fetchurl {
        url = "https://download.qemu.org/qemu-9.0.0.tar.xz";
        hash = "sha256-MnCKxmww2MiSYz6paMdxwcdtWX1w3erSGg0izPOG2mk=";
      };
      patches = [
        "${fetchFromGitHub {
          owner = "proxmox";
          repo = "pve-qemu";
          rev = "14afbdd55f04d250bd679ca1ad55d3f47cd9d4c8";
          hash = "sha256-lSJQA5SHIHfxJvMLIID2drv2H43crTPMNIlIT37w9Nc=";
        }}/debian/patches/pve/0027-PVE-Backup-add-vma-backup-format-code.patch"
      ];
      buildInputs = super.buildInputs ++ [libuuid];
      nativeBuildInputs = super.nativeBuildInputs ++ [perl];
    });
in
  {
    # disko-built raw image derivation (produces `$out/<diskName>.raw`).
    rawImage,
    # qemu-server.conf properties baked into the archive (cores, memory, net0,
    # ...).
    # Must include `virtio0` (its storage prefix feeds the restore drive map).
    qemuConf,
    # Archive base name, e.g. "vzdump-qemu-hephaestus".
    baseName,
  }: let
    cfgLine = name: value: "${name}: ${toString value}\n";
    # Proxmox restore maps the disk via this magic trailer; the storage prefix is
    # the part of `virtio0` before the first colon (e.g. "local-lvm").
    virtio0Storage = builtins.head (builtins.split ":" qemuConf.virtio0);
    confDir = writeTextDir "qemu-server.conf" ''
      # generated by NixOS
      ${lib.concatStrings (lib.mapAttrsToList cfgLine qemuConf)}
      #qmdump#map:virtio0:drive-virtio0:${virtio0Storage}:raw:
    '';
  in
    runCommand "${baseName}.vma.zst" {
      nativeBuildInputs = [vma zstd];
      meta = {
        description = "Proxmox VMA backup archive for ${baseName}";
        inherit (qemu_kvm.meta) platforms;
      };
    } ''
      diskImage=$(ls ${rawImage}/*.raw | head -n1)
      vma create "${baseName}.vma" \
        -c ${confDir}/qemu-server.conf \
        drive-virtio0="$diskImage"
      zstd "${baseName}.vma"

      mkdir -p "$out/nix-support"
      mv "${baseName}.vma.zst" "$out/"
      echo "file vma $out/${baseName}.vma.zst" > "$out/nix-support/hydra-build-products"
    ''
